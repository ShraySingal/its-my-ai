# IT'S MY AI — Environment Configuration

# Server Config
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Default AI Provider: "gemini", "groq", "openai", or "mock" (offline fallback)
DEFAULT_AI_PROVIDER=mock

# Cloud AI Provider Keys (Optional: works offline with 'mock' provider if empty)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Cloud Database & Storage (Supabase PostgreSQL / pgvector)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Intelligence & Weather
OPENWEATHER_API_KEY=

# Security & Permissions
# Levels: 1=SAFE, 2=PERSONAL, 3=SENSITIVE, 4=DANGEROUS
REQUIRE_CONFIRMATION_FOR_SENSITIVE=true
REQUIRE_CONFIRMATION_FOR_DANGEROUS=true

# Device Identification
DEVICE_NAME=Windows-Laptop-Command-Center
DEVICE_TYPE=Laptop
